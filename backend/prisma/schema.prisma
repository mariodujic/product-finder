// Product Finder data model. See DECISIONS.md for the reasoning.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  // Extensionless relative imports: resolvable by tsc, ts-node and Jest alike (CommonJS project).
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle status as maintained in the PIM.
enum ProductStatus {
  ACTIVE
  PHASE_OUT
  DISCONTINUED
}

enum ImportRunStatus {
  RUNNING
  SUCCEEDED
  /// Rejected by a safety check (e.g. the file would delist too much of the catalogue). Nothing was changed.
  ABORTED
  FAILED
}

/// A catalogue product. Owned by the PIM import: the API never writes product master data.
model Product {
  id              Int           @id @default(autoincrement())
  /// Business key from the PIM. Stable public identifier used in URLs.
  sku             String        @unique
  name            String
  chemicalName    String        @map("chemical_name")
  function        String
  applicationArea String        @map("application_area")
  region          String
  certifications  String[]
  status          ProductStatus
  launchYear      Int?          @map("launch_year")
  description     String

  /// False when the SKU was missing from the latest PIM export. Products are never hard-deleted,
  /// so reviews and shared links survive.
  isListed        Boolean       @default(true) @map("is_listed")
  /// Hash of the imported fields; lets the import skip unchanged rows.
  contentHash     String        @map("content_hash")
  lastImportRunId Int?          @map("last_import_run_id")

  /// Denormalised review aggregates, updated in the same transaction as each new review,
  /// so sorting/filtering by rating stays index-friendly at 50k products.
  reviewCount     Int           @default(0) @map("review_count")
  ratingAvg       Decimal?      @map("rating_avg") @db.Decimal(3, 2)

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  reviews         Review[]

  @@index([isListed, status])
  @@index([function])
  @@index([applicationArea])
  @@index([region])
  @@index([launchYear])
  @@index([ratingAvg])
  @@index([certifications], type: Gin)
  @@map("products")
}

/// User-generated content. Must survive any number of re-imports.
model Review {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  /// Restrict: a product with reviews can never be deleted by accident.
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  authorName String   @map("author_name") @db.VarChar(80)
  /// 1..5, enforced by a CHECK constraint in the migration.
  rating     Int      @db.SmallInt
  title      String?  @db.VarChar(120)
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt(sort: Desc)])
  @@map("reviews")
}

/// Audit trail of every import attempt.
model ImportRun {
  id           Int             @id @default(autoincrement())
  source       String
  fileChecksum String          @map("file_checksum")
  status       ImportRunStatus @default(RUNNING)
  startedAt    DateTime        @default(now()) @map("started_at")
  finishedAt   DateTime?       @map("finished_at")
  rowsRead     Int             @default(0) @map("rows_read")
  inserted     Int             @default(0)
  updated      Int             @default(0)
  unchanged    Int             @default(0)
  relisted     Int             @default(0)
  delisted     Int             @default(0)
  skipped      Int             @default(0)
  /// Row-level warnings and errors: [{ line, sku, field, message }]
  issues       Json            @default("[]")
  errorMessage String?         @map("error_message")

  @@map("import_runs")
}
